# ─── LLM / AI ───────────────────────────────────────────────
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=                          # exact model ID from AI Studio
EMBEDDING_MODEL=                    # exact embedding model ID
EMBEDDING_DIM=768
LLM_TIMEOUT_S=8
LLM_MAX_CALLS_PER_MIN=30

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, never expose to client

# ─── Collector ───────────────────────────────────────────────
COLLECTOR_ID=col-local-01
COLLECTOR_API_KEY=                  # one-time enrollment token / API key
INGEST_URL=http://ingest-api:8000
TENANT_SECRET=                      # used for HMAC pseudonymization, stays local
LOCAL_LLM_MODEL=                    # Ollama model for the collector (optional)

# ─── Simulator ───────────────────────────────────────────────
SIMULATOR_INTERVAL_S=5
SIMULATOR_SCENARIO=normal           # normal | spike | memory_leak | db_outage_cascade | login_burst | net_latency

# ─── Postgres (local dev, used by Supabase) ──────────────────
POSTGRES_PASSWORD=
